# ZeeFrame Frontend — environment variables
#
# Next.js loads (in order): .env → .env.local → .env.[NODE_ENV] → .env.[NODE_ENV].local
# For `next dev`, you can keep values in `.env.development` (committed as a team default)
# or copy this file to `.env.local` (usually gitignored) for machine-specific overrides.

# Browser-facing API base (no trailing slash). MUST be the Next.js origin so /api
# requests stay same-site and auth cookies (refresh + csrf) are readable for CSRF.
# Production (Vercel): https://your-app.example
# Local: http://localhost:3000
# NEXT_PUBLIC_API_URL=https://your-app.example

# Server-only FastAPI origin used by next.config rewrites and RSC fetches.
# Never prefix with NEXT_PUBLIC_ — must not ship to the browser bundle.
# Production: https://api.your-app.example
# Local: http://127.0.0.1:8000
# API_UPSTREAM_URL=https://api.your-app.example

# Local development defaults live in `.env.development`.
# Pointing the browser straight at :8000 breaks cookies across origins/ports.

# Sentry browser/server DSN (optional; unset = disabled).
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
