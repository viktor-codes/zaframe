# ZeeFrame Backend - production environment variables
# Copy to .env and fill in values (for deploys, set them in Railway/Render/Neon).

# === Required for production ===
# Runtime environment: dev, staging, or production.
# Production enables cross-site auth cookies: SameSite=None and Secure=true.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require
SECRET_KEY=generate_32_chars_with_openssl_rand_hex_32

# Base URL of the frontend (no trailing slash). Used for Stripe success/cancel URLs.
# Local dev: http://localhost:3000 (or your Vite port)
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Email OTP (optional overrides)
# OTP_EXPIRE_MINUTES=10
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=5
# OTP_RETENTION_DAYS=7
# Allowed CORS origins (comma-separated).
# Local: leave unset; code has defaults for localhost:3000,5173, and similar ports.
# Production: set the frontend URL, e.g. https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# === Optional (required in some production setups) ===
# Redis for distributed rate limiting. Required when ENVIRONMENT=production
# unless ALLOW_INMEMORY_RATE_LIMIT=true (single-instance emergency only).
# Requires the `redis` package (declared in pyproject.toml / requirements.txt).
# REDIS_URL=redis://localhost:6379/0
# ALLOW_INMEMORY_RATE_LIMIT=false
# Bearer token for GET /metrics outside ENVIRONMENT=dev (staging/production).
# METRICS_TOKEN=generate_with_openssl_rand_hex_32
# Pending booking hold window in minutes (seat is reserved until it expires)
# BOOKING_HOLD_MINUTES=15
# Interval for Procfile worker loop (seconds). Prefer Render cron when available.
# BOOKING_LIFECYCLE_INTERVAL_SECONDS=300
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=ZeeFrame <onboarding@your-domain.com>
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
