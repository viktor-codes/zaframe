# ZaFrame Backend — переменные для продакшена
# Скопируйте в .env и заполните (для деплоя задайте в панели Railway/Render/Neon).

# === Обязательно для продакшена ===
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require
SECRET_KEY=сгенерируйте_32_символа_openssl_rand_hex_32

# Base URL of the frontend (no trailing slash). Used for Stripe success/cancel URLs.
# Local dev: http://localhost:3000 (or your Vite port)
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Email OTP (optional overrides)
# OTP_EXPIRE_MINUTES=10
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=5
# OTP_RETENTION_DAYS=7
# Разрешённые origins для CORS (через запятую).
# Локально: не задавай — в коде есть дефолт для localhost:3000,5173 и др.
# Продакшен: укажи URL фронта, например https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# === Опционально ===
# Redis for distributed rate limiting (required when running multiple API instances).
# Without REDIS_URL, slowapi uses in-memory counters (single-instance dev only).
# Requires: uv add "limits[redis]" redis
# REDIS_URL=redis://localhost:6379/0
# Pending booking hold window in minutes (seat is reserved until it expires)
# BOOKING_HOLD_MINUTES=15
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=ZaFrame <onboarding@your-domain.com>
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
