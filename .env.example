# Root env for docker-compose (copy to .env.production — never commit that file).
# Backend app secrets live in backend/.env.example; frontend in frontend/.env.example.

POSTGRES_DB=zeeframe
POSTGRES_USER=zeeframe
POSTGRES_PASSWORD=replace_with_strong_password

# Optional: compose passes these through backend/env_file (.env.production).
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://zeeframe:replace_with_strong_password@postgres:5432/zeeframe
# SECRET_KEY=generate_32_chars_with_openssl_rand_hex_32
# FRONTEND_URL=https://your-app.example
# CORS_ORIGINS=https://your-app.example
# REDIS_URL=redis://redis:6379/0
# METRICS_TOKEN=generate_with_openssl_rand_hex_32
